# SIMULATION runs without credentials. Copy to .env in the repository root.
# .env is loaded only by the Node server and is ignored by Git.
HOST=127.0.0.1
PORT=3001
# none | http-json | api-football. UI starts in SIMULATION; switch to LIVE to connect.
FOOTBALL_PROVIDER=none
FOOTBALL_API_KEY=
# http-json only: absolute URL serving the common JSON match schema (docs/live-data.md).
FOOTBALL_MATCHES_URL=
# api-football only: comma-separated numeric fixture IDs (max 20).
# Empty means discovery of live fixtures (max 20), including tracking their final result.
FOOTBALL_MATCH_IDS=
# Optional independent commentary endpoint, common JSON incident schema.
# If absent/unavailable: structured events remain the fallback.
FOOTBALL_COMMENTARY_URL=
FOOTBALL_COMMENTARY_API_KEY=
LIVE_POLL_MS=15000
LIVE_TIMEOUT_MS=12000

# MULTIPLATFORM — every chat and public output starts OFF.
# Requires FFmpeg with libx264 and AAC; optional flite filter for captured local test voice.
FFMPEG_PATH=ffmpeg
# none | flite. Flite is a local English test voice, not SamuIA's final voice.
BROADCAST_TTS=none

# YouTube: OAuth with read chat scope; write scope additionally needed for metadata.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_VIDEO_ID=
YOUTUBE_RTMP_URL=
YOUTUBE_STREAM_KEY=

# Twitch: channel login + actual live broadcast ID (IRC room ID is not a broadcast ID).
# Anonymous read is used by default. Authenticated IRC requires matching username/token.
TWITCH_CHANNEL=
TWITCH_LIVE_ID=
TWITCH_CHAT_USERNAME=
TWITCH_CHAT_TOKEN=
# Separate credentials for official title/category updates.
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CHANNEL_ID=
TWITCH_RTMP_URL=
TWITCH_STREAM_KEY=

# Kick: official signed webhook subscription chat.message.sent must be authorized.
# Public key PEM may use literal \n; it is not a private key.
KICK_WEBHOOK_PUBLIC_KEY=
KICK_LIVE_ID=
KICK_RTMP_URL=
KICK_STREAM_KEY=

# TikTok: only an approved/authorized upstream. No unofficial scraping connector.
TIKTOK_CHAT_RELAY_URL=
TIKTOK_CHAT_RELAY_TOKEN=
# RTMP/RTMPS only when the account has official LIVE/stream-key access.
TIKTOK_RTMP_URL=
TIKTOK_STREAM_KEY=

# VOICE STUDIO — optional, server-only. Blank keys preserve the existing local voices.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
# Set the exact official consent phrase and BCP-47 language from OpenAI's current guide.
OPENAI_VOICE_CONSENT_TEXT=
OPENAI_VOICE_CONSENT_LANGUAGE=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=
# Optional existing voice preset, not a newly cloned voice.
ELEVENLABS_VOICE_ID=
# Optional private directory outside public/ and Git; default .local/voice-studio.
VOICE_STORAGE_DIR=
FFPROBE_PATH=

# AVATAR ENGINE v9 — optional private storage; default .local/avatar-studio.
AVATAR_STORAGE_DIR=

# SAMUIA NEWS — SIMULATION works without external sources or credentials.
# Exact HTTPS hostnames vetted by the operator (comma separated, no wildcards).
# Also permit these feed hosts in the cloud environment's network settings.
NEWS_ALLOWED_HOSTS=
# Optional Bearer API credential. Never put it in a source URL or browser field.
# It is sent only to this exact hostname, which must also be allowed above.
NEWS_API_HOST=
NEWS_API_KEY=

# NEWS · fase 3. All secrets remain server-only; SIMULACIÓN is the default.
# Requires OPENAI_API_KEY above and network permission for api.openai.com.
OPENAI_NEWS_MODEL=gpt-4.1-mini
# Private persistent file; mount its parent directory as a durable volume.
NEWS_STORAGE_FILE=.local/news/state.json
# Initial polling interval, 60–3600 seconds; saved panel preference takes priority.
NEWS_REFRESH_SECONDS=60
# Optional JSON catalog using config/news-sources.example.json as the empty template.
# Entries are imported disabled; exact domains must already be authorized.
NEWS_SOURCE_CATALOG_FILE=
